---
const {frontmatter,title}=Astro.props;
const pageTitle=title||frontmatter?.title||"StarNootropics/research";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{pageTitle}</title></head><body><header><a class="brand" href="/">StarNootropics /research</a><nav aria-label="Main navigation"><a href="/">Overview</a><a href="/nootropics">Nootropic Monographs</a><a href="/policy">Research Policy</a><a href="/library">Curated Reference Library</a><a href="/monograph-template">Monograph Protocol</a></nav></header><main><slot/></main><footer>© 2026 Star Nootropics. Independent educational research. No supplement store is currently operated here.</footer></body></html><style is:global>
:root{--oxford-navy:#0f2e5a;--ink-primary:#0f172a;--ink-secondary:#334155;--ink-muted:#64748b;--hairline:#d6dde6;--font-serif:Georgia,serif;--font-sans:Arial,sans-serif}*{box-sizing:border-box}body{margin:0;background:#f8fafc;color:#0f172a;font:17px/1.7 Arial,sans-serif}header,main,footer{max-width:1100px;margin:auto;padding:28px}header{border-bottom:2px solid #0f2e5a}.brand{font:32px Georgia,serif}nav{display:flex;gap:22px;flex-wrap:wrap;margin-top:20px}a{color:#0f2e5a}h1,h2,h3{font-family:Georgia,serif;line-height:1.3}h1{font-size:clamp(30px,5vw,44px)}h2{margin-top:36px}p,li{max-width:850px}blockquote{background:#edf3f8;padding:18px;border-left:3px solid #0f2e5a}table{border-collapse:collapse;display:block;overflow:auto}td,th{padding:10px;border:1px solid #d6dde6}footer{border-top:1px solid #d6dde6;font-size:14px}main a{overflow-wrap:anywhere}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.05em}
.monographGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px;margin:28px 0}.monographCard{display:flex;flex-direction:column;gap:16px;padding:28px;background:white;border:1px solid #d6dde6;border-top:3px solid #0f2e5a;text-decoration:none!important;color:#0f172a}.monographCard h3{font:600 25px/1.3 "Source Serif 4",Georgia,serif}.monographCard strong{margin-top:auto;color:#0f2e5a}.monographCard:hover{box-shadow:0 4px 12px #0f172a14}.forthcoming{background:#f1f5f9;color:#536274}.paper{margin-top:28px}.paper h1{font-size:clamp(30px,5vw,46px)}.paper h3{margin:28px 0 16px}.paper blockquote{padding:16px 22px;background:#eef3f8;border-left:3px solid #0f2e5a;margin:24px 0}.paper a{overflow-wrap:anywhere}.archiveControls{display:flex;gap:16px;flex-wrap:wrap;margin:24px 0}.archiveControls button{padding:9px 16px;border:1px solid #ccd5df;background:white;cursor:pointer}.archiveControls button[aria-pressed=true]{background:#0f2e5a;color:white}.archiveControls input{padding:12px;border:1px solid #ccd5df;width:min(100%,420px)}
</style>