    "year": 1991,
    "title": "Effects of oxiracetam-nicotine combinations on active and passive avoidance learning in mice",
    "journalOrPublisher": "Pharmacology Biochemistry and Behavior",
    "citation": "Sansone, M., Castellano, C., Battaglia, M., & Ammassari-Teule, M. (1991). Effects of oxiracetam-nicotine combinations on active and passive avoidance learning in mice. Pharmacology Biochemistry and Behavior, 39(1), 197–200.",
    "doi": "10.1016/0091-3057(91)90421-W",
    "annotation": "Mouse avoidance-learning experiments did not support nicotinic activation as the main oxiracetam mechanism in those tasks."
  },
  {
    "id": "marchi-1990",
    "type": "article",
    "authors": "Marchi, M., Besana, E., & Raiteri, M.",
    "year": 1990,
    "title": "Oxiracetam increases the release of endogenous glutamate from depolarized rat hippocampal slices",
    "journalOrPublisher": "European Journal of Pharmacology",
    "citation": "Marchi, M., Besana, E., & Raiteri, M. (1990). Oxiracetam increases the release of endogenous glutamate from depolarized rat hippocampal slices. European Journal of Pharmacology, 185(2–3), 247–249.",
