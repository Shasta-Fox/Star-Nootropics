---
import Layout from '../layouts/Layout.astro';

interface LiteratureEntry {
  id: string;
  type: 'article' | 'review' | 'trial' | 'book';
  citation: string;
  title: string;
  authors: string;
  year: number;
  journalOrPublisher: string;
  doi?: string;
  directUrl?: string;
  pmid?: string;
  buyQuery?: string; // Triggers Amazon & Bookshop links when present
  annotation?: string;
}

const oxiracetamArchive: LiteratureEntry[] = [
  {
