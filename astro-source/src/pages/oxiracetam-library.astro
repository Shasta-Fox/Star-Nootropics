    "authors": "Wang, L., Guo, H., Zhao, W., Wang, J., & Cao, X.",
    "year": 2025,
    "title": "Oxiracetam ameliorates neurological function after traumatic brain injury through competing endogenous RNA regulatory network",
    "journalOrPublisher": "Psychopharmacology",
    "citation": "Wang, L., Guo, H., Zhao, W., Wang, J., & Cao, X. (2025). Oxiracetam ameliorates neurological function after traumatic brain injury through competing endogenous RNA regulatory network. Psychopharmacology, 242(10), 2275–2291.",
    "doi": "10.1007/s00213-025-06797-9",
    "pmid": "40272502",
    "annotation": "Rat traumatic brain injury model with exploratory analysis of competing endogenous RNA networks."
  },
  {
    "id": "lim-2023",
    "type": "trial",
    "authors": "Lim, J. S., Lee, J., Kang, Y., Park, H. T., Kim, D. E., Cha, J. K., et al.",
    "year": 2023,
    "title": "Efficacy and safety of oxiracetam in patients with vascular cognitive impairment: A multicenter, randomized, double-blinded, placebo-controlled, phase IV clinical trial",
    "journalOrPublisher": "Contemporary Trial Protocols",
    "citation": "Lim, J. S., Lee, J., Kang, Y., Park, H. T., Kim, D. E., Cha, J. K., et al. (2023). Efficacy and safety of oxiracetam in patients with vascular cognitive impairment: A multicenter, randomized, double-blinded, placebo-controlled, phase IV clinical trial. Contemporary Trial Protocols, 126, Article 107108.",
    "doi": "10.1016/j.cct.2023.107108",
    "pmid": "36724841",
    "annotation": "Clinical trial protocol; describes study design and does not report efficacy outcomes. See the completed 2026 trial linked from the monograph."
  },
  {
    "id": "li-2017",
    "type": "article",
    "authors": "Li, W., Liu, H., Jiang, H., Wang, C., Guo, Y., Sun, Y., Zhao, X., et al.",
    "year": 2017,
    "title": "(S)-Oxiracetam is the active ingredient in oxiracetam that alleviates the cognitive impairment induced by chronic cerebral hypoperfusion in rats",
    "journalOrPublisher": "Scientific Reports",
    "citation": "Li, W., Liu, H., Jiang, H., Wang, C., Guo, Y., Sun, Y., Zhao, X., et al. (2017). (S)-Oxiracetam is the active ingredient in oxiracetam that alleviates the cognitive impairment induced by chronic cerebral hypoperfusion in rats. Scientific Reports, 7, Article 10052.",
