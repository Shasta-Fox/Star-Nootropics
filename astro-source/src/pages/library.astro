<Layout title="Star Research Library & Further Reading">
  <div class="library-header">
    <span class="badge">Academic Archive</span>
    <h1>Further Reading & Research Library</h1>
    <p class="subtitle">Scholarly literature, monographs, texts, and multimedia references curated for critical investigation.</p>
  </div>

  <!-- APA 7 REFERENCE GUIDE CALLOUT CARD -->
  <aside class="apa-card">
    <div class="apa-badge">Citation Standard</div>
    <div class="apa-content">
      <h3>APA 7th Edition Reference Style</h3>
      <p>All literature entries in this archive follow the American Psychological Association (APA 7th Edition) reference conventions for scholarly rigor and cross-field consistency.</p>
      <a 
        href="https://apastyle.apa.org/style-grammar-guidelines/references" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="apa-btn"
      >
        Official APA 7 Reference Guide &rarr;
      </a>
    </div>
  </aside>

  <!-- INTERACTIVE CONTROLS -->
  <div class="controls-bar">
    <div class="filter-group">
      <button class="filter-btn active" data-filter="all">All ({references.length})</button>
      <button class="filter-btn" data-filter="book">Books & Monographs</button>
      <button class="filter-btn" data-filter="article">Journal Articles</button>
      <button class="filter-btn" data-filter="media">Films & Media</button>
    </div>
    <input 
      type="text" 
      id="search-input" 
      placeholder="Search author, title, topic..." 
      aria-label="Search references"
    />
  </div>

  <!-- REFERENCE LIST -->
  <div class="reference-list" id="reference-container">
    {references.map((item) => (
      <article class="ref-card" data-type={item.type}>
        <div class="card-meta">
          <span class={`type-pill pill-${item.type}`}>
            {item.type === 'book' ? 'Book' : item.type === 'article' ? 'Journal Article' : 'Multimedia'}
          </span>
          <span class="author-tag">{item.authorYear}</span>
        </div>
        
        <p class="citation-text">{item.citation}</p>

        <div class="action-buttons">
          {item.buyQuery && (
            <div class="buy-links">
              <a 
                href={`https://www.amazon.com/s?k=${encodeURIComponent(item.buyQuery)}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="btn btn-amazon"
                title={`Find "${item.title}" on Amazon`}
              >
                <span>🛒 Buy on Amazon</span>
              </a>
              <a 
                href={`https://bookshop.org/beta/search?keywords=${encodeURIComponent(item.buyQuery)}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="btn btn-bookshop"
                title={`Find "${item.title}" on Bookshop.org (Supports local bookstores)`}
              >
                <span>📖 Bookshop.org</span>
              </a>
            </div>
          )}

          {item.doi && (
            <a 
              href={`https://doi.org/${item.doi}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-doi"
            >
              <span>📄 View Article via DOI &rarr;</span>
            </a>
          )}

          {item.link && (
            <a 
              href={item.link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-link"
            >
              <span>🔗 Open Full Text / Repository &rarr;</span>
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</Layout>

<style>
  .library-header {
    margin-bottom: 2rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: #e0f2fe;
    color: #0284c7;
    margin-bottom: 0.5rem;
  }
  .subtitle {
    font-size: 1.05rem;
    color: #64748b;
    margin-top: -0.5rem;
  }

  /* APA Callout Card */
  .apa-card {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-left: 5px solid #16a34a;
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .apa-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #15803d;
    letter-spacing: 0.05em;
  }
  .apa-content h3 {
    margin: 0 0 0.35rem 0;
    font-size: 1.15rem;
    color: #14532d;
  }
  .apa-content p {
    margin: 0 0 1rem 0;
    color: #166534;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .apa-btn {
    display: inline-block;
    background: #16a34a;
    color: #ffffff !important;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 0.2s;
    width: fit-content;
  }
  .apa-btn:hover {
    background: #15803d;
  }

  /* Controls */
  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: center;
  }
  .filter-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 0.4rem 0.85rem;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }
  .filter-btn:hover {
    background: #e2e8f0;
  }
  .filter-btn.active {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
  }
  #search-input {
    flex: 1;
    min-width: 220px;
    max-width: 320px;
    padding: 0.45rem 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.85rem;
    outline: none;
  }
  #search-input:focus {
    border-color: #0284c7;
  }

